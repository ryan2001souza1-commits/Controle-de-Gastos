{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "memory": 512,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/js/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*\\.php)",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
