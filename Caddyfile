# =============================================================================
# Caddyfile — Roteamento para o Controle de Gastos (FrankenPHP)
# =============================================================================
#
# A aplicação PHP usa ?action=... como router:
#   /index.php?action=login     → login
#   /index.php?action=metas     → metas
#   /index.php                  → dashboard (sem action)
#
# FrankenPHP embutido no Caddy serve como web server.
# A imagem base já contém o binário frankenphp + Caddy.
# =============================================================================

# Porta (FrankenPHP injeta PORT em containers; usar 8080 como fallback)
{$PORT:-8080}

# ---------------------------------------------------------------------------
# GZIP
# ---------------------------------------------------------------------------
encode gzip

# ---------------------------------------------------------------------------
# 1. Arquivos estáticos (CSS, JS, imagens, fontes)
#    Todos estão dentro de public/ no projeto, servidos a partir de /app/public.
# ---------------------------------------------------------------------------
@static-files {
    file
    path *.css *.js *.woff2 *.woff *.ttf *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.map *.txt
}

handle @static-files {
    root * /app/public
    file_server
    precompressed zstd gzip
}

# ---------------------------------------------------------------------------
# 2. Rotas PHP que existem como arquivos reais na raiz de public
#    /login.php, /register.php, /dashboard.php, /lancamentos.php etc.
#    O php_server detecta o arquivo pelo PATH_INFO e passa ?action=... ao PHP.
# ---------------------------------------------------------------------------
@php-files {
    file
    path_regexp ^/([^/]+)\.php$
}

handle @php-files {
    root * /app/public
    php_server
}

# ---------------------------------------------------------------------------
# 3. O entry point principal: /index.php
#    Todas as requisições sem extensão (.php) vão para cá com ?action=...
#    O try_files com ? no final preserva a query string original.
#    Sem isso, ?action=login seria perdido nareescrita.
# ---------------------------------------------------------------------------
@index-route {
    not {
        file
    }
}

handle @index-route {
    try_files {path}? {path} /index.php? /index.php
    rewrite * {try_files}
    root * /app/public
    php_server
}

# ---------------------------------------------------------------------------
# 4. Fallback: requisição que não bateu em nenhum handler acima.
#    Tenta /index.php como último recurso, repassando query string.
# ---------------------------------------------------------------------------
handle {
    rewrite * /index.php?{query}
    root * /app/public
    php_server
}
