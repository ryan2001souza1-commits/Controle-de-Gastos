# =============================================================================
# .env — Variáveis de ambiente
# =============================================================================
# Copie para .env e preencha os valores.
# Na Vercel, configure em Settings → Environment Variables.
# O .env NÃO é enviado ao repositório (.gitignore já ignora).
# =============================================================================

# ---- PostgreSQL via DATABASE_URL (recomendado) -----------------------------
# Forneça a connection string completa do seu banco PostgreSQL gerenciado.
# Suporta Neon, Supabase, Vercel Postgres, Railway, Render, etc.
# Exemplo:
#   postgres://user:senha@host:5432/dbname?sslmode=require
DATABASE_URL=postgres://usuario:SUA_SENHA@host:5432/nome_do_banco?sslmode=require

# ---- Alternativa: variáveis individuais (para dev local) --------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=controle_gastos
# DB_USER=postgres
# DB_PASS=sua_senha_real

# ---- Admin inicial (opcional) -----------------------------------------------
# Defina o administrador exclusivo do painel /admin via variáveis de ambiente.
# NÃO coloque a senha no código ou no Git. Configure na Vercel em
# Settings → Environment Variables ou no seu .env local (ignorado pelo Git).
# A migração cria/promove o usuário automaticamente no primeiro deploy.
# ADMIN_EMAIL=seu-email-admin@exemplo.com
# ADMIN_PASSWORD=sua-senha-forte-com-min-8-caracteres
# ADMIN_NAME=Administrador

# ---- Token de setup (opcional, recomendado em produção) ----------------------
# Se definido, o endpoint setup_first_admin exigirá o mesmo valor via param
# `secret=` na requisição. Se vazio/indefinido, o endpoint é executável
# apenas enquanto não houver nenhum admin cadastrado (comportamento original).
# SETUP_SECRET=algum-token-forte-de-pelo-menos-32-caracteres-aleatorios

# ---- Assistente IA (OpenRouter / OpenAI compatível) ------------------------
# Configure o provedor de IA. Chave NUNCA vai para o frontend — apenas servidor.
# Para OpenRouter (recomendado): https://openrouter.ai/
#   OPENROUTER_API_KEY=sk-or-v1-...
# Genérico:
#   AI_API_KEY=sk-... (sua chave existente)
#   AI_API_URL=https://openrouter.ai/api/v1/chat/completions
#   AI_MODEL=openrouter/free
# Exemplos: openrouter/free (roteador gratuito - custo zero), qwen/qwen3-30b-a3b:free, google/gemma-3n-e4b-it:free
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openrouter/free
# Opcional: ajuste de geração
# AI_MAX_TOKENS=700
# AI_TEMPERATURE=0.35
# APP_URL usado como HTTP-Referer para OpenRouter (opcional)
# APP_URL=https://seu-dominio.vercel.app

# ---- App ------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false
