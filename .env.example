# =============================================================================
# .env.example — Template de variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com seus valores reais.
# Em deploy na Vercel, configure as variáveis no painel do projeto.
# =============================================================================

# ---- PostgreSQL ------------------------------------------------------------
# Em produção, use um serviço gerenciado (Neon, Supabase, RDS, Vercel Postgres).
# Em dev local, use docker-compose (veja docker-compose.yml).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=controle_gastos
DB_USER=postgres
DB_PASS=123

# Alternativa: connection string completa (tem precedência se fornecida)
# Formato: postgres://user:password@host:port/database?sslmode=require
# DATABASE_URL=postgres://user:pass@db.example.com:5432/controle_gastos?sslmode=require

# ---- App ------------------------------------------------------------------
APP_ENV=production
APP_DEBUG=false

# (Opcional) Sentry / Sentry DSN para tracking de erros em produção
# SENTRY_DSN=
